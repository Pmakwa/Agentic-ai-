      "status": "REQUIRED"
    },
    "monte_carlo_ruin_probability": {
      "maximum": 5.0,
      "unit": "pct at 95% confidence",
      "status": "REQUIRED"
    },
    "cost_shock_survival": {
      "multiplier": 3.0,
      "requirement": "Must retain positive net expectancy under 3x spread and commissions",
      "status": "REQUIRED"
    },
    "data_leakage_audit": {
