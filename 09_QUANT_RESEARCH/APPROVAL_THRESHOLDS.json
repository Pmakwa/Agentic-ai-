      "minimum": 1.5,
      "unit": "ratio",
      "status": "REQUIRED"
    },
    "profit_factor": {
      "minimum": 1.65,
      "unit": "ratio",
      "status": "REQUIRED"
    },
    "maximum_drawdown": {
      "maximum": 20.0,
      "unit": "pct",
      "status": "REQUIRED"
    },
